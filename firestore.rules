rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow public reads for foods, but require auth for writes and validate expiryHours
    match /foods/{foodId} {
      allow read: if true;
      allow create: if request.auth != null
                      && request.resource.data.keys().hasAll(["name","quantity","expiry","ownerId","createdAt","expiryHours"])
                      && request.resource.data.ownerId == request.auth.uid
                      && (request.resource.data.expiryHours is int);
      // allow update if user is owner and expiryHours (if present) is int
      allow update: if request.auth != null
                      && resource.data.ownerId == request.auth.uid
                      && ( !("expiryHours" in request.resource.data) || (request.resource.data.expiryHours is int) );
      // allow delete only by owner
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    // Users collection: only allow authenticated user to create their own doc and read their own
    match /users/{userId} {
      allow create: if request.auth != null && request.auth.uid == userId;
      allow read: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false; // don't allow deletes via client
    }

    // Deny everything else by default
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }
  }
}
